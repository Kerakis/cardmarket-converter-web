		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/file-saver": "^2.0.7",
		"@types/node": "^26",
		"@types/papaparse": "^5.5.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
